# Maintainer: Francesco De Campo <frdcmp at users.noreply.github.com>
#
# Development package, built from the main branch. Usable before any
# release exists and without an AUR account: clone the repo and run
# `makepkg -si` in this directory.

pkgname=auriscope-git
pkgver=r0.0000000
pkgrel=1
pkgdesc="Audio player and analyser: waveform, spectrogram, spectrum, loudness (git)"
arch=('x86_64' 'aarch64')
url="https://github.com/frdcmp/auriscope"
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('alsa-lib' 'libxkbcommon' 'wayland' 'gtk3' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=('vulkan-driver: GPU rendering through wgpu')
provides=('auriscope')
conflicts=('auriscope')
source=("auriscope::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd auriscope
  # 0.1.0.r12.gabcdef0 when a tag exists, otherwise r<count>.g<hash>.
  git describe --long --tags --abbrev=7 2>/dev/null \
    | sed 's/^v//; s/\([^-]*-g\)/r\1/; s/-/./g' \
    || printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd auriscope
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd auriscope
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # No in-app update check: pacman is the update channel.
  cargo build --frozen --release --no-default-features --features gtk
}

check() {
  cd auriscope
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release
}

package() {
  cd auriscope
  install -Dm755 target/release/auriscope "$pkgdir/usr/bin/auriscope"
  install -Dm644 assets/io.github.frdcmp.Auriscope.desktop \
    "$pkgdir/usr/share/applications/io.github.frdcmp.Auriscope.desktop"
  install -Dm644 assets/io.github.frdcmp.Auriscope.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.frdcmp.Auriscope.svg"
  install -Dm644 assets/io.github.frdcmp.Auriscope.metainfo.xml \
    "$pkgdir/usr/share/metainfo/io.github.frdcmp.Auriscope.metainfo.xml"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 assets/fonts/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
  install -Dm644 README.md "$pkgdir/usr/share/doc/auriscope/README.md"
}
